{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "noEmit": true,
    "paths": {
      "@stemlight/core/*": ["./packages/core/*"],
      "@stemlight/audio/*": ["./packages/audio/*"],
      "@stemlight/storage/*": ["./packages/storage/*"],
      "@stemlight/timeline/*": ["./packages/timeline/*"],
      "@stemlight/xlights/*": ["./packages/xlights/*"],
      "@timing/*": ["./apps/timing/src/*"]
    }
  },
  "include": ["apps", "packages", "tests", "tools", "vite.config.ts"]
}
